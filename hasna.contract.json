{
  "schema": "hasna.service_contract.v1",
  "name": "emails",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.8.4",
  "description": "Emails stores in the local SQLite file by default, or in operator-owned PostgreSQL when HASNA_MAILERY_DATABASE_URL is set. Provider credentials stay with the operator.",
  "bins": [
    "emails",
    "emails-mcp",
    "emails-serve"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "http-api",
      "kind": "api",
      "status": "supported",
      "bin": "emails-serve",
      "authMode": "api-key",
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": false
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/openapi.json"
    },
    {
      "name": "typescript-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "exportSubpath": ".",
      "generatedFrom": "/openapi.json"
    },
    {
      "name": "mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "emails-mcp",
      "authMode": "local-only"
    },
    {
      "name": "cli",
      "kind": "cli",
      "status": "supported",
      "bin": "emails",
      "authMode": "local-only"
    }
  ],
  "storage": {
    "mode": "sqlite",
    "engines": [
      "sqlite",
      "postgres"
    ],
    "envPrefix": "HASNA_EMAILS_",
    "sqlitePath": "~/.hasna/emails/emails.db",
    "pgTestGate": {
      "envVar": "EMAILS_TEST_DATABASE_URL",
      "command": "bun test"
    }
  },
  "metadata": {
    "apiKeyApp": "emails",
    "apiKeyAppAliases": [
      "mailery"
    ],
    "apiScopes": [
      "emails:read",
      "emails:write"
    ],
    "databaseUrlEnv": "EMAILS_DATABASE_URL",
    "apiSigningKeyEnv": "EMAILS_API_SIGNING_KEY",
    "healthPath": "/health",
    "readyPath": "/ready",
    "versionPath": "/version",
    "openapiPath": "/openapi.json",
    "migrateCommand": [
      "emails",
      "db",
      "migrate"
    ],
    "automaticDeploy": false
  }
}
