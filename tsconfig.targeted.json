{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "bun-types"
    ]
  },
  "files": [
    "src/cli/commands/daemon.local.ts",
    "src/cli/commands/daemon.remote.ts",
    "src/cli/commands/domain.ts",
    "src/cli/commands/email-log.local.ts",
    "src/cli/commands/email-log.remote.ts",
    "src/cli/commands/inbox.local.ts",
    "src/cli/commands/misc.local.ts",
    "src/cli/commands/sync.local.ts",
    "src/cli/tui-solid/context/emails-state.tsx",
    "src/cli/tui/data.local.ts",
    "src/cli/tui/data.remote.ts",
    "src/cli/tui/data.ts",
    "src/db/emails.ts",
    "src/db/provisioning.ts",
    "src/index.ts",
    "src/lib/batch.ts",
    "src/lib/domain-readiness-service.ts",
    "src/lib/domain-readiness.ts",
    "src/lib/export.ts",
    "src/lib/forwarding.ts",
    "src/lib/send.local.ts",
    "src/lib/send.remote.ts",
    "src/lib/send.ts",
    "src/lib/sent-ledger.local.ts",
    "src/lib/stats.ts",
    "src/lib/warming.ts",
    "src/mcp/resources.local.ts",
    "src/mcp/resources.remote.ts",
    "src/mcp/resources.ts",
    "src/mcp/tools/email-ops.ts",
    "src/mcp/tools/misc-ops.ts",
    "src/mcp/tools/warming.ts",
    "src/server/routes/contacts-groups.ts",
    "src/server/routes/core.ts",
    "src/server/routes/inbound-sequences.ts",
    "src/storage.ts",
    "src/types/index.ts"
  ]
}
